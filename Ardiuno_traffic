// ---------------- PIN SETUP ----------------
//#include <SoftwareSerial.h>//gps
int BUZZER = A0;

int gptx = A0;
int pgrx = A1;

int R_TOP = 2;
int G_TOP = 4;

int R_LEFT = 5;
int G_LEFT = 7;

int R_RIGHT = 8;
int G_RIGHT = 10;

int R_BOTTOM = 11;
int G_BOTTOM = 13;

void setup() {
  Serial.begin(9600);
  Serial.println("GPS Module Initializing...");

  
  pinMode(BUZZER, OUTPUT);
  digitalWrite(BUZZER, LOW);

  pinMode(R_TOP, OUTPUT);
  pinMode(G_TOP, OUTPUT);

  pinMode(R_LEFT, OUTPUT);
  pinMode(G_LEFT, OUTPUT);

  pinMode(R_RIGHT, OUTPUT);
  pinMode(G_RIGHT, OUTPUT);

  pinMode(R_BOTTOM, OUTPUT);
  pinMode(G_BOTTOM, OUTPUT);

  allRed();   // Start with all RED
}
